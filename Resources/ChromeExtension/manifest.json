{
  "manifest_version": 3,
  "name": "Valora 下载",
  "short_name": "Valora",
  "version": "1.0.0",
  "description": "将 Google Chrome 的 HTTP(S) 下载交给 Valora 原有下载列表。",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Valora 下载",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
